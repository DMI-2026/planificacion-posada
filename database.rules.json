{
  "rules": {
    ".read": false,
    ".write": false,
    "cohetazo": {
      ".read": "auth != null",
      "jugadores": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.getPriority() == null && newData.hasChildren(['nombre', 'x', 'y', 'dir', 'vivo', 'reaparece', 'alcance', 'cohetes', 'velocidad', 't'])",
          "nombre": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
          "x": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 20" },
          "y": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 16" },
          "dir": { ".validate": "newData.isString() && (newData.val() === 'arriba' || newData.val() === 'abajo' || newData.val() === 'izquierda' || newData.val() === 'derecha')" },
          "vivo": { ".validate": "newData.isBoolean()" },
          "reaparece": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000" },
          "alcance": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 6" },
          "cohetes": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 5" },
          "velocidad": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 3" },
          "t": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      },
      "avatares": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.getPriority() == null && newData.isString() && newData.val().length >= 1 && newData.val().length <= 20000"
        }
      },
      "cohetes": {
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || data.child('colocado').val() < now - 10000)))",
          ".validate": "newData.getPriority() == null && newData.hasChildren(['uid', 'x', 'y', 'alcance', 'colocado'])",
          "uid": { ".validate": "newData.isString()" },
          "x": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 20" },
          "y": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 16" },
          "alcance": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 6" },
          "colocado": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      },
      "cajas": {
        "$xy": {
          ".write": "auth != null",
          ".validate": "$xy.matches(/^([0-9]|1[0-9]|20)_([0-9]|1[0-6])$/) && newData.getPriority() == null && newData.hasChildren(['rota', 'por'])",
          "rota": { ".validate": "newData.val() === now" },
          "por": { ".validate": "newData.val() === auth.uid" },
          "$other": { ".validate": false }
        }
      },
      "mejoras": {
        "$key": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
          ".validate": "$key.matches(/^[0-9]{1,2}_[0-9]{1,2}_[0-9]{13}$/) && newData.getPriority() == null && newData.isString()"
        }
      },
      "eliminaciones": {
        "$id": {
          ".write": "auth != null && !data.exists() && newData.exists()",
          ".validate": "newData.getPriority() == null && newData.hasChildren(['victima', 'autor', 't'])",
          "victima": { ".validate": "newData.val() === auth.uid" },
          "autor": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128" },
          "t": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      },
      "$other": { ".write": false, ".validate": false }
    }
  }
}
