rules_version = '2';

// Reglas de Firestore de la posada (proyecto posada-dmi-2026).
// Principio: mínimo privilegio. Todo lo que no se permite aquí abajo está
// denegado, y cada escritura valida las claves y los tipos exactos que
// escribe el `toMap` de los modelos de la app.
//
// Roles: quien tiene un documento `admins/{uid}` es admin (edita el evento,
// gestiona participantes y aportaciones). Los demás usuarios con sesión solo
// gestionan lo suyo: su asistencia y las aportaciones que ellos llevan.
// Ese documento se crea a mano (consola de Firebase o emulador), nunca desde
// la app: ver docs/como-correr.md ("Cómo nombrar admin").
service cloud.firestore {
  match /databases/{database}/documents {

    // Sesión iniciada (Firebase Auth).
    function haySesion() {
      return request.auth != null;
    }

    // Admin: sesión iniciada y documento `admins/{uid}` existente.
    function esAdmin() {
      return haySesion()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Por defecto: todo denegado (cualquier ruta que no se liste abajo).
    match /{document=**} {
      allow read, write: if false;
    }

    // Roles. Cada quien puede leer solo su propio documento (para saber si
    // es admin); nadie escribe desde la app.
    match /admins/{adminUid} {
      allow read: if haySesion() && request.auth.uid == adminUid;
      allow write: if false;
    }

    // Evento de la posada: un único documento `evento/actual`.
    match /evento/{eventoId} {
      // Datos válidos del evento: solo estas claves y tipos (Evento.toMap).
      function eventoValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nombre', 'fecha', 'lugar', 'notas'])
          && d.keys().hasAll(['nombre', 'fecha', 'lugar', 'notas'])
          && d.nombre is string && d.nombre.size() >= 1 && d.nombre.size() <= 100
          && d.fecha is timestamp
          && d.lugar is string && d.lugar.size() <= 200
          && d.notas is string && d.notas.size() <= 1000;
      }

      // Leer: cualquier usuario con sesión.
      allow read: if haySesion();
      // Crear/actualizar: solo el admin, solo el documento `actual`, datos válidos.
      allow create, update: if esAdmin() && eventoId == 'actual' && eventoValido();
      // Borrar: nunca.
      allow delete: if false;
    }

    // Participantes de la posada: una cuenta registrada = un documento cuyo
    // id es su uid (`participantes/{uid}`). No se guarda el correo.
    match /participantes/{participanteId} {
      // Datos válidos (Participante.toMap).
      function participanteValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nombre', 'asistencia'])
          && d.keys().hasAll(['nombre', 'asistencia'])
          && d.nombre is string && d.nombre.size() >= 1 && d.nombre.size() <= 100
          && d.asistencia in ['si', 'no', 'tal_vez'];
      }

      // Solo cambia la asistencia (el nombre no se toca).
      function soloAsistencia() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['asistencia']);
      }

      // Leer: cualquier usuario con sesión.
      allow read: if haySesion();
      // Crear: cada quien su propio documento (id = su uid).
      allow create: if haySesion() && request.auth.uid == participanteId
        && participanteValido();
      // Actualizar: solo la asistencia; la propia, o cualquiera si es admin.
      allow update: if haySesion() && participanteValido() && soloAsistencia()
        && (request.auth.uid == participanteId || esAdmin());
      // Borrar (quitar de la lista): solo el admin.
      allow delete: if esAdmin();
    }

    // Aportaciones (artículos que alguien llevará).
    match /aportaciones/{aportacionId} {
      // Datos válidos (Aportacion.toMap).
      function aportacionValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['articulo', 'cantidad', 'responsable_id', 'lista'])
          && d.keys().hasAll(['articulo', 'cantidad', 'responsable_id', 'lista'])
          && d.articulo is string && d.articulo.size() >= 1 && d.articulo.size() <= 100
          && d.cantidad is int && d.cantidad >= 1 && d.cantidad <= 999
          && (d.responsable_id == null || d.responsable_id is string)
          && d.lista is bool;
      }

      // Cambio de un participante (no admin): solo `responsable_id` y `lista`.
      // - El nuevo responsable es nadie o él mismo.
      // - El anterior era nadie o él mismo (no se le quita a otra persona).
      // - Si cambia `lista`, la aportación debe quedar a cargo de él mismo.
      function cambioPropio() {
        let nuevo = request.resource.data;
        let viejo = resource.data;
        return nuevo.diff(viejo).affectedKeys().hasOnly(['responsable_id', 'lista'])
          && (nuevo.responsable_id == null || nuevo.responsable_id == request.auth.uid)
          && (viejo.responsable_id == null || viejo.responsable_id == request.auth.uid)
          && (nuevo.lista == viejo.lista || nuevo.responsable_id == request.auth.uid);
      }

      // Leer: cualquier usuario con sesión.
      allow read: if haySesion();
      // Crear: con sesión y datos válidos; libre o a su nombre, y sin marcar
      // como lista (salvo el admin).
      allow create: if haySesion() && aportacionValida()
        && (request.resource.data.responsable_id == null
            || request.resource.data.responsable_id == request.auth.uid)
        && (request.resource.data.lista == false || esAdmin());
      // Actualizar: el admin cualquier cambio válido; los demás, `cambioPropio`.
      allow update: if haySesion() && aportacionValida()
        && (esAdmin() || cambioPropio());
      // Borrar: solo el admin.
      allow delete: if esAdmin();
    }
  }
}
